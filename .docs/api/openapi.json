      "get" : {
        "tags" : [ "Analytics" ],
        "summary" : "Painel da loja do token: ticket médio, benchmarking, picos e compras cruzadas",
        "operationId" : "dashboard",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DashboardResponse"
                }
              }
            }
          }
        }
      }
