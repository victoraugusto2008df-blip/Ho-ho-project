{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Shopping Analytics & Loyalty Hub API",
    "description" : "API do MVP da Equipe 22 (Ho-Ho). Faça login em POST /api/v1/auth/login e informe o token em Authorize.",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "Analytics",
    "description" : "Painéis agregados, com K-Anonymity (ReN05)"
  }, {
    "name" : "Autenticação",
    "description" : "Login dos usuários de demonstração"
  }, {
    "name" : "Estacionamento",
    "description" : "Meta de R$ 150,00 no dia e voucher (ReN03, ReN04)"
  }, {
    "name" : "Campanhas",
    "description" : "Disparo simulado de cupom pelo lojista, sem expor CPFs"
  }, {
    "name" : "Notas fiscais",
    "description" : "Cadastro de NFC-e pelo consumidor (ReN01, ReN02, RF03)"
  } ],
  "paths" : {
    "/api/v1/notas" : {
      "post" : {
        "tags" : [ "Notas fiscais" ],
        "summary" : "Cadastra uma nota pela chave de acesso de 44 dígitos",
        "operationId" : "ingerir",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NotaRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NotaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/campanhas" : {
      "post" : {
        "tags" : [ "Campanhas" ],
        "summary" : "Dispara uma campanha para os clientes da loja do token inativos há mais de 60 dias",
        "operationId" : "disparar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CampanhaRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CampanhaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "Autenticação" ],
        "summary" : "Autentica por e-mail e senha e devolve o JWT",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/notas/hoje" : {
      "get" : {
        "tags" : [ "Notas fiscais" ],
        "summary" : "Lista as notas aprovadas do consumidor emitidas hoje",
        "operationId" : "notasDeHoje",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NotaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/beneficios/estacionamento/hoje" : {
      "get" : {
        "tags" : [ "Estacionamento" ],
        "summary" : "Progresso do consumidor na meta de hoje e o voucher, se liberado",
