      "get" : {
        "tags" : [ "Analytics" ],
        "summary" : "Visão do shopping: faturamento, vouchers, campanhas e faturamento por categoria",
        "operationId" : "dashboardShopping",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ShoppingDashboardResponse"
                }
              }
            }
          }
        }
