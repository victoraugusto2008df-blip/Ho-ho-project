  "components" : {
    "schemas" : {
      "NotaRequest" : {
        "type" : "object",
        "properties" : {
          "chaveAcesso" : {
            "type" : "string"
          }
        }
      },
      "NotaResponse" : {
        "type" : "object",
        "properties" : {
          "chaveAcesso" : {
            "type" : "string"
          },
          "valorTotal" : {
            "type" : "number"
          },
          "dataEmissao" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string"
          },
          "clienteId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lojaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "estabelecimento" : {
            "type" : "string"
          },
          "categoria" : {
            "type" : "string"
          }
        }
      },
      "CampanhaRequest" : {
        "type" : "object",
        "properties" : {
          "titulo" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "descontoPercentual" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1
          },
          "criterioAlvo" : {
            "type" : "string",
            "pattern" : "INATIVOS_60_DIAS"
          }
        },
        "required" : [ "criterioAlvo", "descontoPercentual" ]
      },
      "CampanhaResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "titulo" : {
            "type" : "string"
          },
          "descontoPercentual" : {
            "type" : "integer",
            "format" : "int32"
          },
          "criterioAlvo" : {
            "type" : "string"
          },
          "publicoAtingido" : {
            "type" : "integer",
            "format" : "int32"
          },
          "criadoEm" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "senha" : {
            "type" : "string",
            "minLength" : 1
          }
        }
      },
      "LoginResponse" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          },
          "lojaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "clienteId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "EstacionamentoHojeResponse" : {
        "type" : "object",
        "properties" : {
          "valorAcumulado" : {
            "type" : "number"
          },
          "meta" : {
            "type" : "number"
          },
          "percentual" : {
            "type" : "integer",
            "format" : "int32"
          },
          "valorFaltante" : {
            "type" : "number"
          },
          "voucherLiberado" : {
            "type" : "boolean"
          },
          "cpfMascarado" : {
            "type" : "string"
          },
          "voucher" : {
            "$ref" : "#/components/schemas/VoucherResponse"
          }
        }
      },
      "VoucherResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "codigoQr" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "dataReferencia" : {
            "type" : "string",
            "format" : "date"
          },
          "criadoEm" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FaturamentoCategoria" : {
        "type" : "object",
        "properties" : {
          "categoria" : {
            "type" : "string"
          },
          "valor" : {
            "type" : "number"
          }
        }
      },
      "ShoppingDashboardResponse" : {
        "type" : "object",
        "properties" : {
          "faturamentoTotal" : {
            "type" : "number"
          },
          "vouchersLiberados" : {
            "type" : "integer",
            "format" : "int64"
          },
          "campanhasAtivas" : {
            "type" : "integer",
            "format" : "int64"
          },
          "faturamentoPorCategoria" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FaturamentoCategoria"
            }
          }
        }
      },
      "CrossShoppingItem" : {
        "type" : "object",
        "properties" : {
          "categoria" : {
            "type" : "string"
          },
          "total" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "DashboardResponse" : {
        "type" : "object",
        "properties" : {
          "ticketMedio" : {
            "type" : "number"
          },
          "benchmarkingDisponivel" : {
            "type" : "boolean"
          },
          "mediaCategoria" : {
            "type" : "number"
          },
          "horariosPico" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PicoHora"
            }
          },
          "diasPico" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PicoDia"
            }
          },
          "crossShopping" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CrossShoppingItem"
            }
          }
        }
      },
      "PicoDia" : {
        "type" : "object",
        "properties" : {
          "diaSemana" : {
            "type" : "string"
          },
          "total" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "PicoHora" : {
        "type" : "object",
        "properties" : {
          "hora" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
